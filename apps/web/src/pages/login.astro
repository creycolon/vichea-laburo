---
import Layout from '../layouts/Layout.astro';
const err = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('ok');
const next = Astro.url.searchParams.get('next') ?? '/panel';
const configured = Astro.locals.configured;
---
<Layout title="Ingresar — Radar Junior">
  <main class="auth">
    <div class="wrap" style="display:grid;place-items:center">
      <div class="auth-box">
        <h1>Ingresar</h1>
        <p class="sub">Entrá para ver el radar completo y guardar búsquedas.</p>

        {!configured && (
          <div class="alert warn">
            Supabase no está configurado. Copiá <code>.env.example</code> a <code>.env</code>,
            pegá <code>SUPABASE_URL</code> y <code>SUPABASE_ANON_KEY</code>, y reiniciá el servidor.
          </div>
        )}
        {err && <div class="alert err">{err}</div>}
        {ok && <div class="alert ok">{ok}</div>}

        <form method="post" action="/api/auth/login">
          <input type="hidden" name="next" value={next} />
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="vos@empresa.com" />
          </div>
          <div class="field">
            <label for="password">Contraseña</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" minlength="8" />
          </div>
          <button class="btn primary block" type="submit">Entrar</button>
        </form>

        <div class="auth-foot">
          <a href="/recuperar">Olvidé mi contraseña</a>
          <span>·</span>
          <span>¿No tenés cuenta? <a href="/registro">Crear una</a></span>
        </div>
      </div>
    </div>
  </main>
</Layout>
