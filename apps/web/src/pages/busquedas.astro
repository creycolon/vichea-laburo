---
import Layout from '../layouts/Layout.astro';
import { getJobs } from '../lib/jobs';
import { createSupabase } from '../lib/supabase';

const user = Astro.locals.user!;
const jobs = getJobs();
const supabase = createSupabase(Astro.cookies, Astro.request.headers.get('cookie'));

// Búsquedas guardadas: de Supabase si está configurado, si no quedan vacías (el
// guardado en modo demo vive en localStorage del navegador).
let guardadas: { id: string; name: string; filters: any }[] = [];
if (supabase) {
  const { data } = await supabase.from('saved_searches').select('id, name, filters').order('created_at', { ascending: false });
  guardadas = data ?? [];
}

const geos = [...new Set(jobs.map((j) => j.geo))];
const mods = [...new Set(jobs.map((j) => j.modality))];
const areas = [...new Set(jobs.map((j) => j.area))].sort();
const ok = Astro.url.searchParams.get('ok');
---

<Layout title="Búsquedas — Vichea Laburo">
  <main>
    <div class="wrap">
      <div class="panel-head">
        <div>
          <h1>Ofertas</h1>
          <div class="who">{jobs.length} avisos junior/trainee · {user.email}</div>
        </div>
        <form method="post" action="/api/auth/logout" style="margin-left:auto">
          <button class="btn ghost" type="submit">Salir</button>
        </form>
      </div>

      {ok && <div class="alert ok">Búsqueda guardada.</div>}

      <div class="profile" id="profilePanel">
        <div class="profile-head">
          <strong>Mi perfil</strong>
          <span class="dim" id="profileState">sin perfil</span>
          <button class="chip" id="clearProfile">Limpiar perfil</button>
        </div>
        <div class="profile-body">
          <div>
            <span class="lbl">Qué sabés hacer</span>
            <div class="chips" id="skills"></div>
          </div>
          <div class="profile-selects">
            <label>Quiero… <select id="intent">
              <option value="primer-empleo">mi primer empleo</option>
              <option value="cambiar-area">cambiar de área</option>
              <option value="remoto">trabajar remoto</option>
              <option value="mejorar">mejorar lo que tengo</option>
            </select></label>
            <label>Modalidad <select id="pmod">
              <option value="cualquiera">cualquiera</option>
              <option value="remoto">remoto</option>
              <option value="híbrido">híbrido</option>
              <option value="presencial">presencial</option>
            </select></label>
            <label>Dónde <select id="pgeo">
              <option value="cualquiera">cualquiera</option>
              <option value="Argentina">Argentina</option>
              <option value="LATAM">LATAM</option>
              <option value="Global / remoto">global</option>
            </select></label>
          </div>
          <p class="dim" style="margin:6px 0 0;font-size:12px">Se guarda solo en este navegador.</p>
        </div>
      </div>

      <div class="toolbar">
        <input type="search" id="q" placeholder="Puesto, empresa, tecnología…" />
        <span class="chip on" data-k="geo" data-v="">Todas</span>
        {geos.map((g) => <span class="chip" data-k="geo" data-v={g}>{g}</span>)}
        <span style="width:100%"></span>
        <span class="chip on" data-k="modality" data-v="">Toda modalidad</span>
        {mods.map((m) => <span class="chip" data-k="modality" data-v={m}>{m}</span>)}
        <span class="count" id="count"></span>
      </div>

      <div class="toolbar">
        <span class="chip on" data-k="area" data-v="">Toda área</span>
        {areas.map((a) => <span class="chip" data-k="area" data-v={a}>{a}</span>)}
        <span class="chip" id="minFit" title="Sólo ofertas con 60% o más de afinidad">Solo ≥60% afinidad</span>
        <button class="btn" id="saveBtn" style="margin-left:auto">Guardar esta búsqueda</button>
      </div>

      <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Puesto y por qué</th><th>Empresa</th><th>Ubicación</th><th>Modalidad</th><th>Área</th><th>Antig.</th><th>Señales</th><th>Afinidad</th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
      </div>

      <section class="block" id="guardadas">
        <h2 style="font-size:19px">Búsquedas guardadas</h2>
        <p class="sub" style="margin-bottom:14px" id="guardadasSub"></p>
        <div id="guardadasList"></div>
      </section>
    </div>
  </main>

  <script define:vars={{ jobs, guardadas, configured: Astro.locals.configured, dev: import.meta.env.DEV }}>
    window.__RADAR__ = { jobs, guardadas, configured, dev };
  </script>
  <script>
    import '../client/busquedas.ts';
  </script>
</Layout>
