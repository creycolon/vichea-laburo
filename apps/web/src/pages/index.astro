---
import Layout from '../layouts/Layout.astro';
import { getStats } from '../lib/stats';

const s = getStats();
const updated = s.updatedAt
  ? new Date(s.updatedAt).toLocaleString('es-AR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })
  : 'sin datos todavía';
const pct = (n: number) => (s.total ? Math.round((n / s.total) * 100) : 0);
const alta = Astro.url.searchParams.get('alta');
---

<Layout title="Vichea Laburo — inteligencia de demanda laboral junior en LATAM">
  <main>
    <section class="hero">
      <div class="wrap">
        <span class="eyebrow">Datos públicos · criterio propio</span>
        <h1>Quién está contratando <em>junior</em> en Argentina, esta semana.</h1>
        <p class="lead">
          Relevamos los portales todos los días, deduplicamos las ofertas y las normalizamos por
          empresa, ubicación y modalidad. Lo que ves no es una lista de avisos: es el mapa de
          dónde se está abriendo la puerta para perfiles que recién empiezan.
        </p>
        <div class="hero-cta">
          <a class="btn primary" href="/registro">Probar gratis</a>
          <a class="btn" href="#producto">Ver qué incluye</a>
          <span class="note">Sin tarjeta. La muestra se actualiza sola.</span>
        </div>

        <div class="stats">
          <div>
            <b>{s.total}</b>
            <span>ofertas junior abiertas</span>
          </div>
          <div>
            <b>{s.ar}</b>
            <span>en Argentina</span>
            <div class="mods">
              <span>{s.modality.presencial ?? 0} presencial</span>
              <span>{s.modality['híbrido'] ?? 0} híbrido</span>
              <span>{s.modality.remoto ?? 0} remoto</span>
            </div>
          </div>
          <div>
            <b>{s.companies}</b>
            <span>empresas contratando</span>
          </div>
          <div>
            <b>{s.sources.length}</b>
            <span>fuentes con resultados</span>
            <div class="mods"><span>última corrida: {updated}</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="block" id="producto">
      <div class="wrap">
        <h2>De avisos sueltos a una decisión</h2>
        <p class="sub">
          Cada oferta se ve una sola vez aunque aparezca en tres portales, y cada empresa se agrupa
          aunque escriba su nombre distinto en cada sitio.
        </p>
        <div class="grid3">
          <article class="card">
            <div class="icon">◎</div>
            <h3>Quién contrata y cuánto</h3>
            <p>Empresas con búsquedas junior abiertas, cuántas tienen y hace cuántos días no las cierran.</p>
          </article>
          <article class="card">
            <div class="icon b">◑</div>
            <h3>Modalidad real</h3>
            <p>Presencial, híbrido o remoto no se adivina: viene del dato de origen y se etiqueta en cada aviso.</p>
          </article>
          <article class="card">
            <div class="icon v">↗</div>
            <h3>Serie temporal</h3>
            <p>Guardamos un corte por día, así podés comparar contra la semana pasada en vez de mirar una foto.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="block" id="como">
      <div class="wrap">
        <h2>Cómo funciona</h2>
        <p class="sub">Tres etapas, ninguna mágica.</p>
        <div class="pasos">
          <div class="paso">
            <div>
              <h3>Relevamiento</h3>
              <p>Cada día consultamos los portales y guardamos el crudo: título, empresa, ubicación, modalidad y fecha.</p>
            </div>
          </div>
          <div class="paso">
            <div>
              <h3>Normalización y deduplicación</h3>
              <p>Se unifican nombres de empresas, se corrigen ubicaciones y la misma búsqueda en dos sitios se convierte en una sola oferta.</p>
            </div>
          </div>
          <div class="paso">
            <div>
              <h3>Lectura</h3>
              <p>El panel te muestra el estado de hoy contra el de ayer: qué abrió, qué cerró y qué lleva demasiado tiempo sin cubrirse.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="block" id="precios">
      <div class="wrap">
        <h2>Precios</h2>
        <p class="sub">Empezás gratis con la muestra. Cuando necesites serie histórica y alertas, pasás a un plan.</p>
        <div class="grid3">
          <article class="card">
            <h3 style="margin-top:0">Explorador</h3>
            <p style="font-size:26px;color:var(--txt);margin:6px 0 4px"><b>$0</b></p>
            <p>Búsqueda del día, filtros por modalidad y ubicación. Sin histórico.</p>
          </article>
          <article class="card" style="border-color:color-mix(in srgb, var(--accent) 45%, var(--line))">
            <h3 style="margin-top:0">Analista</h3>
            <p style="font-size:26px;color:var(--txt);margin:6px 0 4px"><b>USD 29</b><span style="font-size:13px;color:var(--dim)">/mes</span></p>
            <p>Serie histórica, reporte por empresa y alertas diarias por email.</p>
          </article>
          <article class="card">
            <h3 style="margin-top:0">Equipo</h3>
            <p style="font-size:26px;color:var(--txt);margin:6px 0 4px"><b>USD 99</b><span style="font-size:13px;color:var(--dim)">/mes</span></p>
            <p>Usuarios ilimitados, API con clave propia y exportación.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="block" id="alta">
      <div class="wrap">
        <div class="cta">
          <div>
            <h2>Probalo con tu búsqueda</h2>
            <p class="sub" style="margin-bottom:0">
              Creás la cuenta, elegís qué te interesa y el radar te avisa cuando aparece algo nuevo.
              Si todavía no querés cuenta, dejamos tu email para el reporte semanal.
            </p>
          </div>
          {alta === 'ok' && <div class="alert ok" style="grid-column:1/-1;margin:0">Listo, quedaste anotado. Te escribimos cuando haya novedades.</div>}
          {alta === 'demo' && <div class="alert warn" style="grid-column:1/-1;margin:0">Supabase no está configurado: el formulario no puede guardar todavía.</div>}
          {alta === 'error' && <div class="alert err" style="grid-column:1/-1;margin:0">No pudimos guardar tu email. Probá de nuevo en un rato.</div>}
          <form class="form" method="post" action="/api/waitlist" style="grid-column:2">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required placeholder="vos@empresa.com" autocomplete="email" />
            <label for="role">¿Con qué te identificás?</label>
            <select id="role" name="role">
              <option value="recruiter">Reclutador / consultora</option>
              <option value="bootcamp">Academia o bootcamp</option>
              <option value="rrhh">RRHH interno</option>
              <option value="candidato">Busco trabajo</option>
            </select>
            <button class="btn primary block" type="submit">Quiero el reporte</button>
            <span class="legal">Un email por semana. Sin vueltas y con baja en un clic.</span>
          </form>
        </div>
      </div>
    </section>
  </main>
</Layout>
