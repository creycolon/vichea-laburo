---
import '../styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = 'Inteligencia de demanda laboral junior y trainee en LATAM.' } = Astro.props;
const user = Astro.locals.user;
const demo = Astro.locals.demo;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap">
        <a class="brand" href="/"><span class="dot"></span> Vichea Laburo</a>
        <nav>
          <a href="/#producto">Producto</a>
          <a href="/#como">Cómo funciona</a>
          <a href="/#precios">Precios</a>
        </nav>
        <div class="actions">
          {user || demo ? (
            <a class="btn primary" href="/panel">Ir al panel</a>
          ) : (
            <>
              <a class="btn ghost" href="/login">Ingresar</a>
              <a class="btn primary" href="/registro">Probar gratis</a>
            </>
          )}
        </div>
      </div>
    </header>
    <slot />
    <footer class="site">
      <div class="wrap">
        <strong>Vichea Laburo</strong>
        <span>·</span>
        <span>Datos de fuentes públicas, normalizados y deduplicados.</span>
        <span style="margin-left:auto">© {new Date().getFullYear()}</span>
      </div>
    </footer>
  </body>
</html>
